#autoload
dockerctl() {
	if [[ $# -lt 1 ]]; then
		echo "Usage: dockerctl {start|stop|restart|status|logs|clean|update} {service1|all} ..."
		return 1
	fi

	local action="$1"
	shift

	case "$action" in
	start | stop | restart | status | logs | clean | update) ;;
	*)
		echo "❌ Invalid action '$action'. Use: start, stop, restart, status, logs, clean, update"
		return 1
		;;
	esac

	# Determine services
	local services=()
	if [[ "$1" == "all" ]]; then
		for d in "$HOME/Personal/myDocker/"*/; do
			services+=("$(basename "$d")")
		done
	else
		services=("$@")
	fi

	# Add dependencies for litellm if starting
	if [[ " ${services[*]} " == *" litellm "* && "$action" == "start" ]]; then
		[[ " ${services[*]} " != *" redis "* ]] && services=("redis" "${services[@]}")
	fi

	for service in "${services[@]}"; do
		local dir="$HOME/Personal/myDocker/$service"
		if [[ ! -d "$dir" ]]; then
			echo "❌ Service '$service' not found at $dir"
			continue
		fi

		echo "🔧 $action $service..."
		(
			cd "$dir" || {
				echo "❌ Failed to cd $dir"
				return 1
			}
			case "$action" in
			start) docker compose up -d ;;
			stop) docker compose down ;;
			restart) docker compose down && sleep 2 && docker compose up -d ;;
			status) docker compose ps ;;
			logs) docker compose logs -f ;;
			clean)
				docker compose down
				docker system prune -a --volumes -f
				;;
			update)
				docker compose pull   # fetch latest images
				docker compose down   # stop current container
				docker compose up -d  # start with latest
				docker image prune -f # remove old dangling images
				;;
			esac
		)
		echo "✅ $action $service done!"
	done
}
