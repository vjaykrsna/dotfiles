#autoload
dockerctl() {
	if [[ $# -lt 1 ]]; then
		echo "Usage: dockerctl {start|stop|restart|status|logs|clean|update} {service1|all} ..."
		return 1
	fi

	local action="$1"
	shift

	case "$action" in
	start | stop | restart | status | logs | clean | update) ;;
	*)
		echo "❌ Invalid action '$action'. Use: start, stop, restart, status, logs, clean, update"
		return 1
		;;
	esac

	# Determine services
	local services=()
	if [[ "$1" == "all" ]]; then
		local CONFIG_FILE="$HOME/.config/dockerctl/config"
		if [[ -f "$CONFIG_FILE" ]]; then
			source "$CONFIG_FILE"
		fi
		local DOCKERCTL_PROJECTS_DIR="${DOCKERCTL_PROJECTS_DIR:-$HOME/Personal/myDocker}"
		for d in "$DOCKERCTL_PROJECTS_DIR/"*/; do
			services+=("$(basename "$d")")
		done
	else
		services=("$@")
	fi

	# Add dependencies if starting
	if [[ "$action" == "start" && -n "${DOCKERCTL_DEPS-}" ]]; then
		local resolved_services=()
		for service in "${services[@]}"; do
			if [[ -n "${DOCKERCTL_DEPS[$service]-}" ]]; then
				for dep in ${DOCKERCTL_DEPS[$service]}; do
					if [[ ! " ${resolved_services[*]} " =~ " $dep " ]]; then
						resolved_services+=("$dep")
					fi
				done
			fi
			if [[ ! " ${resolved_services[*]} " =~ " $service " ]]; then
				resolved_services+=("$service")
			fi
		done
		services=("${resolved_services[@]}")
	fi

	for service in "${services[@]}"; do
		local dir="$DOCKERCTL_PROJECTS_DIR/$service"
		if [[ ! -d "$dir" ]]; then
			echo "❌ Service '$service' not found at $dir"
			continue
		fi

		echo "🔧 $action $service..."
		(
			cd "$dir" || {
				echo "❌ Failed to cd $dir"
				return 1
			}
			case "$action" in
			start) docker compose up -d ;;
			stop) docker compose down ;;
			restart) docker compose down && sleep 2 && docker compose up -d ;;
			status) docker compose ps ;;
			logs) docker compose logs -f ;;
			clean)
				docker compose down
				docker system prune -a --volumes -f
				;;
			update)
				docker compose pull   # fetch latest images
				docker compose down   # stop current container
				docker compose up -d  # start with latest
				docker image prune -f # remove old dangling images
				;;
			esac
		)
		echo "✅ $action $service done!"
	done
}
