#autoload
addsubmodule() {
    emulate -L zsh
    setopt no_unset

    # --- Options ---
    local DRY_RUN=false
    local AUTO=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) DRY_RUN=true; shift ;;
            --auto) AUTO=true; shift ;;
            *) break ;;
        esac
    done

    # --- Colors ---
    local BLUE='\033[0;34m'
    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local RED='\033[0;31m'
    local NC='\033[0m'

    _info()  { echo -e "${BLUE}ℹ️  $*${NC}"; }
    _warn()  { echo -e "${YELLOW}⚠️  $*${NC}"; }
    _ok()    { echo -e "${GREEN}✅ $*${NC}"; }
    _error() { echo -e "${RED}❌ $*${NC}"; }

    local search_dir="$PWD"
    _info "Scanning recursively from: $search_dir"

    # --- Find nested repos ---
    local -a nested_repos=()
    while IFS= read -r git_dir; do
        local repo_path=$(dirname "$git_dir")
        [[ "$repo_path" == "$search_dir" ]] && continue

        # Skip if already a submodule
        if ! git -C "$search_dir" config --file .gitmodules --get-regexp "^submodule\..*\.path$" | grep -qx "$repo_path"; then
            nested_repos+=("$repo_path")
        fi
    done < <(find "$search_dir" -type d -name ".git")

    if (( ${#nested_repos[@]} == 0 )); then
        _info "No nested repositories found."
        return 0
    fi

    # --- Process each nested repo ---
    for repo in "${nested_repos[@]}"; do
        local remote_url
        remote_url=$(git -C "$repo" config --get remote.origin.url)

        if [[ -z "$remote_url" ]]; then
            _warn "Skipping $repo — no remote URL found."
            continue
        fi

        local relative_path=${repo#"$search_dir"/}
        _info "Nested repo: $relative_path"
        _info "Remote URL: $remote_url"

        if [[ "$DRY_RUN" == true ]]; then
            _info "[Dry-run] Would add $relative_path as a submodule"
            continue
        fi

        if [[ "$AUTO" != true ]]; then
            read -q "confirm?Add this as a submodule? (y/N): "
            echo ""
            [[ ! "$confirm" =~ ^[Yy]$ ]] && { _info "Skipped $relative_path"; continue; }
        fi

        # --- Remove from index, keep disk files ---
        git -C "$search_dir" rm --cached "$relative_path" >/dev/null 2>&1 || _warn "Could not remove $relative_path from index"

        # --- Add submodule ---
        if git -C "$search_dir" submodule add "$remote_url" "$relative_path"; then
            _ok "Added $relative_path as a submodule."
        else
            _error "Failed to add $relative_path."
        fi
    done

    _info "Done. Remember to commit: git add . && git commit -m 'Added nested repos as submodules'"
}
