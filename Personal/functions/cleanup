#autoload
# Ultimate Cleanup Utility - Extended Version

cleanup() {
    emulate -L zsh
    set -u
    local DRY_RUN=false
    [[ "${1-}" == "--dry-run" ]] && DRY_RUN=true && shift

    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local BLUE='\033[0;34m'
    local RED='\033[0;31m'
    local NC='\033[0m'
    typeset -A freed_space

    info()  { echo -e "${BLUE}ℹ️  $*${NC}"; }
    ok()    { echo -e "${GREEN}✅ $*${NC}"; }
    warn()  { echo -e "${YELLOW}⚠️  $*${NC}"; }
    error() { echo -e "${RED}❌ $*${NC}"; }

    # ----------------------
    # Safe delete function
    # ----------------------
    _safe_delete() {
        local path="$1" description="$2" use_sudo="${3:-false}"
        [[ -z "$path" || "$path" == "/" || "$path" == "$HOME" ]] && error "Unsafe path: $path" && return
        /usr/bin/echo "Processing $description..."
        setopt nullglob globdots extendedglob
        local -a files=($~path)
        local total=0
        for f in "${files[@]}"; do
            [[ ! -e "$f" ]] && continue
            local size=$(/usr/bin/du -sb -- "$f" 2>/dev/null | /usr/bin/awk '{print $1}') || size=0
            total=$((total + size))
            if [[ "$DRY_RUN" == true ]]; then
                warn "[DRY RUN] Would delete $description: $f ($(/usr/bin/numfmt --to=iec-i --suffix=B $size))"
            else
                if [[ "$use_sudo" == true ]]; then
                    /usr/bin/sudo /usr/bin/rm -rf -- "$f" 2>/dev/null || warn "Failed to delete $f"
                else
                    /usr/bin/rm -rf -- "$f" 2>/dev/null || warn "Failed to delete $f"
                fi
            fi
        done
        [[ $total -gt 0 ]] && freed_space["$description"]=$(( ${freed_space["$description"]:-0} + total ))
    }

    # ----------------------
    # Run command and track space
    # ----------------------
    _run_and_track_space() {
        local description="$1" monitor_path="$2"; shift 2
        local before=0 after=0
        [[ -d "$monitor_path" ]] && before=$(/usr/bin/du -sb -- "$monitor_path" 2>/dev/null | /usr/bin/awk '{print $1}') || before=0
        if [[ "$DRY_RUN" == true ]]; then
            warn "[DRY_RUN] Would run: $description"
        else
            info "Running: $description"
            "$@" || warn "$description failed"
        fi
        [[ -d "$monitor_path" ]] && after=$(/usr/bin/du -sb -- "$monitor_path" 2>/dev/null | /usr/bin/awk '{print $1}') || after=0
        local freed=$((before - after))
        [[ $freed -gt 0 ]] && freed_space["$description"]=$(( ${freed_space["$description"]:-0} + freed ))
    }

    # ----------------------
    # Basic Cleanup
    # ----------------------
    cleanup_basic() {
        info "--- Starting Basic Cleanup ---"
        _safe_delete "$HOME/.cache/thumbnails/*" "Thumbnail Cache"
        _safe_delete "$HOME/.cache/google-chrome" "Chrome Cache"
        _safe_delete "$HOME/.cache/mozilla/firefox" "Firefox Cache"
        _safe_delete "$HOME/.var/app/app.zen_browser.zen/cache/*" "Zen Browser Cache"
        _safe_delete "$HOME/.local/share/Trash/files/*" "Trash Files"
        _safe_delete "$HOME/.local/share/Trash/info/*" "Trash Info Files"

        [[ "$DRY_RUN" == true ]] || /usr/bin/sudo /usr/bin/apt-get clean
        [[ "$DRY_RUN" == true ]] || /usr/bin/sudo /usr/bin/apt-get autoclean -y
        [[ "$DRY_RUN" == true ]] || /usr/bin/sudo /usr/bin/apt-get autoremove --purge -y

        ok "--- Basic Cleanup Complete ---"
    }

    # ----------------------
    # Advanced Cleanup
    # ----------------------
    cleanup_advanced() {
        info "--- Starting Advanced Cleanup ---"
        cleanup_basic

        # Node / JavaScript
        _safe_delete "$HOME/.npm" "NPM Cache" true
        _safe_delete "$HOME/.npm/_logs/*" "NPM Logs"
        _safe_delete "$HOME/.cache/yarn" "Yarn Cache"
        _safe_delete "$HOME/.pnpm-store" "PNPM Store"
        _safe_delete "$HOME/.cache/node-gyp/*" "Node-gyp Cache"

        # Python
        _safe_delete "$HOME/.cache/pip" "Python pip cache"
        _safe_delete "$HOME/.local/share/virtualenvs" "Python virtualenvs"

        # Rust / Cargo
        _safe_delete "$HOME/.cargo/registry/cache/*" "Cargo Registry Cache"
        _safe_delete "$HOME/Personal/**/target" "Rust Target Folders"

        # Java / Maven / Gradle
        _safe_delete "$HOME/.m2/repository/*" "Maven Repository"
        _safe_delete "$HOME/.gradle/caches/*" "Gradle Cache"

        # Go
        _safe_delete "$HOME/go/pkg/mod/cache/*" "Go Module Cache"

        # VSCode
        _safe_delete "$HOME/.vscode/extensions/.obsolete/*" "VSCode Obsolete Extensions"

        # System
        _safe_delete "/var/lib/snapd/cache/*" "Snap Cache" true
        _safe_delete "/var/cache/man/*" "Man-db Cache" true
        _run_and_track_space "Flatpak Unused" "/var/lib/flatpak" /usr/bin/flatpak uninstall --unused -y
        [[ "$DRY_RUN" == true ]] || /usr/bin/sudo /usr/bin/systemctl clean --what=temporary --what=cache
        [[ "$DRY_RUN" == true ]] || /usr/bin/sudo /usr/bin/journalctl --vacuum-size=1M
        _safe_delete "/var/lib/systemd/coredump/*" "Systemd Core Dumps" true

        # Docker
        [[ "$DRY_RUN" == true ]] || /usr/bin/sudo /usr/bin/docker system prune -af --volumes

        # Git
        /usr/bin/find "$HOME/Personal" -name ".git" -type d -prune -print0 | while IFS= read -r -d '' g; do
            [[ "$DRY_RUN" == true ]] && warn "[DRY_RUN] Would run git gc in $g" && continue
            /usr/bin/git --git-dir="$g" --work-tree="$(/usr/bin/dirname "$g")" gc --prune=now --aggressive
        done

        ok "--- Advanced Cleanup Complete ---"
    }

    # ----------------------
    # Report
    # ----------------------
    show_report() {
        info "--- Cleanup Report ---"
        local total=0
        for k in "${(@k)freed_space}"; do total=$((total + freed_space[$k])); done
        echo -e "${GREEN}Total freed:${NC} $([[ $total -gt 0 ]] && /usr/bin/numfmt --to=iec-i --suffix=B $total || echo "0B")"

        if (( total == 0 )); then
            warn "Nothing left to clean!"
            return
        fi

        info "--- Top Freed ---"
        for line in "${(@f)$(for k in "${(@k)freed_space}"; do echo "${freed_space[$k]}|$k"; done | /usr/bin/sort -rn | /usr/bin/head -n5)}"; do
            local size="${line%%|*}"
            local desc="${line##*|}"
            echo "  - $desc ($(/usr/bin/numfmt --to=iec-i --suffix=B $size))"
        done
    }

    # ----------------------
    # Menu
    # ----------------------
    while true; do
        echo -e "\n${BLUE}===== Ultimate Cleanup Utility =====${NC}"
        echo -e " ${GREEN}1.${NC} Basic Cleanup (safe)"
        echo -e " ${GREEN}2.${NC} Advanced Cleanup (aggressive)"
        echo -e " ${GREEN}q.${NC} Quit"
        echo -n -e "${YELLOW}Enter choice: ${NC}"

        read -r choice
        case "$choice" in
            1) cleanup_basic ;;
            2) cleanup_advanced ;;
            [qQ]) break ;;
            *) error "Invalid option" ;;
        esac
    done

    show_report
}

cleanup "$@"
