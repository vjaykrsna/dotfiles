#autoload
cleanup() {
    emulate -L zsh
    set -u
    local IFS=$'\n\t'

    # --- CONFIG ---
    DRY_RUN=false
    local -A freed_space

    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local BLUE='\033[0;34m'
    local RED='\033[0;31m'
    local NC='\033[0m'

    info()  { echo -e "${BLUE}ℹ️  $*${NC}"; }
    ok()    { echo -e "${GREEN}✅ $*${NC}"; }
    warn()  { echo -e "${YELLOW}⚠️  $*${NC}"; }
    error() { echo -e "${RED}❌ $*${NC}"; return 1; }

    # --- SAFETY DELETE ---
    _safe_delete() {
        local path="$1" use_sudo="${2:-false}" description="$3"

        [[ -z "$path" || "$path" == "/" || "$path" == "$HOME" ]] && error "Unsafe path: $path" && return

        # Expand globs safely
        setopt nullglob globdots extendedglob
        local -a paths=($~path)
        [[ ${#paths[@]} -eq 0 ]] && return

        local total=0
        for p in "${paths[@]}"; do
            [[ ! -e "$p" ]] && continue
            local size=0
            size=$(/usr/bin/du -sb -- "$p" 2>/dev/null | /usr/bin/awk '{print $1}') || size=0
            total=$((total + size))

            if [[ "$DRY_RUN" == true ]]; then
                local human=$([[ $size -gt 0 ]] && /usr/bin/numfmt --to=iec-i --suffix=B "$size" || echo "0B")
                warn "[DRY RUN] Would delete $description: $p ($human)"
            else
                if [[ "$use_sudo" == true ]]; then
                    /usr/bin/sudo /usr/bin/rm -rf -- "$p" 2>/dev/null || warn "Failed to delete $p"
                else
                    /usr/bin/rm -rf -- "$p" 2>/dev/null || warn "Failed to delete $p"
                fi
            fi
        done

        [[ $total -gt 0 ]] && freed_space["$description"]=$(( ${freed_space["$description"]:-0} + total ))
    }

    # --- COMMAND WRAPPER ---
    _run_cmd() {
        local description="$1"; shift
        if [[ "$DRY_RUN" == true ]]; then
            warn "[DRY RUN] Would run: $description"
        else
            info "Running: $description"
            "$@" || warn "$description failed"
        fi
    }

    _can_sudo() { /usr/bin/sudo -n true 2>/dev/null; }

    # --- BASIC CLEANUP ---
    cleanup_basic() {
        info "--- Starting Basic Cleanup ---"
        _run_cmd "APT Cleanup" /usr/bin/sudo /usr/bin/apt-get clean
        _run_cmd "APT Autoclean" /usr/bin/sudo /usr/bin/apt-get autoclean
        _run_cmd "APT Autoremove" /usr/bin/sudo /usr/bin/apt-get autoremove --purge -y
        _run_cmd "Flatpak Unused" /usr/bin/flatpak uninstall --unused -y
        _run_cmd "Journal Cleanup" /usr/bin/sudo /usr/bin/journalctl --vacuum-size=1M

        _safe_delete "$HOME/.cache/thumbnails/*" false "Thumbnail Caches"
        _safe_delete "$HOME/.cache/google-chrome" false "Chrome Cache"
        _safe_delete "$HOME/.cache/mozilla/firefox" false "Firefox Cache"
        _safe_delete "$HOME/.cache/yarn" false "Yarn Cache"
        _safe_delete "$HOME/.local/share/Trash/files/*" false "Trash Files"
        _safe_delete "/var/cache/man/*" true "Man-db Cache"

        ok "--- Basic Cleanup Complete ---"
    }

    # --- PYTHON VENV CLEANUP ---
    cleanup_python_venvs() {
        local description="Python Virtual Envs"
        info "Cleaning Python virtual environments (skipping pipx & poetry)..."
        while IFS= read -r -d '' venv; do
            local dir=$(/usr/bin/dirname "$venv")
            [[ "$dir" == "$HOME/.local/share/pipx/venvs"* ]] && continue
            [[ "$dir" == "$HOME/.cache/pypoetry"* ]] && continue
            _safe_delete "$dir" false "$description"
        done < <(/usr/bin/find "$HOME" -type f -name "pyvenv.cfg" -print0)
    }

    # --- DOCKER ---
    cleanup_docker() {
        local desc="Docker Cleanup"
        _run_cmd "$desc" /usr/bin/sudo /usr/bin/docker system prune -af --volumes
    }

    # --- GIT GC ---
    cleanup_git() {
        local desc="Git Repos GC"
        info "Running git gc under ~/Personal..."
        /usr/bin/find "$HOME/Personal" -name ".git" -type d -prune -print0 | while IFS= read -r -d '' g; do
            _run_cmd "Git GC in $g" /usr/bin/git --git-dir="$g" --work-tree="$(/usr/bin/dirname "$g")" gc --prune=now --aggressive
        done
    }

    # --- ADVANCED CLEANUP ---
    cleanup_advanced() {
        info "--- Starting Advanced Cleanup ---"
        cleanup_basic

        _safe_delete "$HOME/.m2/repository/*" false "Maven Repository"
        _safe_delete "$HOME/.gradle/caches/*" false "Gradle Caches"
        _safe_delete "$HOME/.cargo/registry/cache/*" false "Cargo Registry Cache"
        _safe_delete "$HOME/Personal/**/target" false "Rust Target Folders"

        cleanup_python_venvs

        if [[ "$DRY_RUN" == false ]]; then
            read -q "REPLY?Proceed with Docker & Git cleanup? (y/n) "; echo
            [[ "$REPLY" =~ ^[Yy]$ ]] && cleanup_docker && cleanup_git || warn "Skipping Docker & Git cleanup."
        else
            warn "[DRY RUN] Skipping Docker & Git prompt, would run both"
            cleanup_docker
            cleanup_git
        fi

        ok "--- Advanced Cleanup Complete ---"
    }

    # --- REPORT ---
    show_report() {
        info "--- Cleanup Report ---"
        local total=0
        for k in "${(@k)freed_space}"; do
            total=$((total + freed_space[$k]))
        done
        echo -e "${GREEN}Total freed:${NC} $([[ $total -gt 0 ]] && /usr/bin/numfmt --to=iec-i --suffix=B "$total" || echo "0B")"

        info "--- Top 5 Hogs ---"
        for line in "${(@f)$(for k in "${(@k)freed_space}"; do echo "${freed_space[$k]}|$k"; done | /usr/bin/sort -rn | /usr/bin/head -n5)}"; do
            local size="${line%%|*}"
            local desc="${line##*|}"
            local human=$([[ $size -gt 0 ]] && /usr/bin/numfmt --to=iec-i --suffix=B "$size" || echo "0B")
            echo "  - $desc ($human)"
        done
    }

    # --- MENU ---
    show_menu() {
        echo -e "
${BLUE}===== Ultimate Developer Cleanup Utility =====${NC}
 ${GREEN}1. Basic Cleanup${NC} (Safe)
 ${GREEN}2. Advanced Cleanup${NC} (Aggressive)
 ${GREEN}q. Quit${NC}"
        echo -n -e "${YELLOW}Enter choice: ${NC}"
    }

    [[ "${1-}" == "--dry-run" ]] && DRY_RUN=true && shift

    while true; do
        show_menu
        read -r choice
        case "$choice" in
            1) cleanup_basic ;;
            2) cleanup_advanced ;;
            [qQ]) break ;;
            *) error "Invalid option" ;;
        esac
    done

    show_report

    unfunction info ok warn error _safe_delete _run_cmd _can_sudo cleanup_basic cleanup_python_venvs cleanup_docker cleanup_git cleanup_advanced show_report show_menu 2>/dev/null || true
}
