#autoload
cleanup() {
    emulate -L zsh       # Make all options local
    set -u # Treat unset variables as errors
    local IFS=$'\n\t'

    DRY_RUN=false
    local -A freed_space

    # --- COLORS ---
    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local BLUE='\033[0;34m'
    local RED='\033[0;31m'
    local NC='\033[0m'

    info() { echo -e "${BLUE}ℹ️  $*${NC}"; }
    ok() { echo -e "${GREEN}✅ $*${NC}"; }
    warn() { echo -e "${YELLOW}⚠️  $*${NC}"; }
    error() { echo -e "${RED}❌ $*${NC}"; return 1; }

    # --- SAFE CLEANUP ITEM ---
    _cleanup_item() {
        local pattern="$1"
        local description="$2"
        local use_sudo="${3:-false}"

        [[ -z "$pattern" || "$pattern" == "/" || "$pattern" == "$HOME" ]] && error "Unsafe path: $pattern" && return

        setopt globstar nullglob dotglob
        local -a paths
        paths=($~pattern)
        [[ ${#paths[@]} -eq 0 ]] && return

        local total_size=0
        for p in "${paths[@]}"; do
            [[ ! -e "$p" ]] && continue
            local size
            size=$(du -sb -- "$p" 2>/dev/null | awk '{print $1}') || size=0
            total_size=$(( total_size + size ))

            if [[ "$DRY_RUN" == true ]]; then
                warn "[DRY RUN] Would delete $description: $p ($(numfmt --to=iec-i --suffix=B $size))"
            else
                if [[ "$use_sudo" == true ]]; then
                    sudo rm -rf -- "$p"
                else
                    rm -rf -- "$p"
                fi
            fi
        done

        [[ $total_size -gt 0 ]] && freed_space["$description"]=$(( ${freed_space["$description"]:-0} + total_size ))
    }

    # --- SAFE COMMAND ---
    _cleanup_cmd() {
        local description="$1"; shift
        if [[ "$DRY_RUN" == true ]]; then
            warn "[DRY RUN] Would run: $description"
        else
            info "Running: $description"
            "$@" || warn "$description failed"
        fi
    }

    # --- SUDO CHECK ---
    _can_sudo() { sudo -n true 2>/dev/null; }

    # --- BASIC CLEANUP ---
    cleanup_basic() {
        info "--- Starting Basic Cleanup ---"
        _can_sudo && _cleanup_cmd "APT Cleanup" sudo apt-get clean
        _can_sudo && _cleanup_cmd "APT Autoclean" sudo apt-get autoclean
        _can_sudo && _cleanup_cmd "APT Autoremove" sudo apt-get autoremove --purge -y
        _cleanup_cmd "Flatpak Unused" flatpak uninstall --unused -y
        _can_sudo && _cleanup_cmd "Journal Cleanup" sudo journalctl --vacuum-size=1M

        _cleanup_item "$HOME/.cache/thumbnails/*" "Thumbnail Caches"
        _cleanup_item "$HOME/.cache/google-chrome" "Chrome Cache"
        _cleanup_item "$HOME/.cache/mozilla/firefox" "Firefox Cache"
        _cleanup_item "$HOME/.cache/yarn" "Yarn Cache"
        _cleanup_item "$HOME/.local/share/Trash/files/*" "Trash Files"
        _cleanup_item "/var/cache/man/*" "Man-db Cache"
        ok "--- Basic Cleanup Complete ---"
    }

    # --- SAFE PYTHON VENV CLEANUP ---
    _cleanup_python_venvs() {
        local description="Python Virtual Envs"
        info "Cleaning Python virtual environments..."
        while IFS= read -r -d '' venvfile; do
            local venvdir size
            venvdir=$(dirname "$venvfile")
            size=$(du -sb -- "$venvdir" 2>/dev/null | awk '{print $1}') || size=0
            if [[ "$DRY_RUN" == true ]]; then
                warn "[DRY RUN] Would remove $venvdir ($(numfmt --to=iec-i --suffix=B $size))"
            else
                rm -rf -- "$venvdir"
                freed_space["$description"]=$(( ${freed_space["$description"]:-0} + size ))
            fi
        done < <(find "$HOME" -type f -name "pyvenv.cfg" -print0)
    }

    # --- SAFE DOCKER CLEANUP ---
    _cleanup_docker() {
        local description="Docker Cleanup"
        _cleanup_cmd "$description" sudo docker system prune -af --volumes
    }

    # --- SAFE GIT GC ---
    _cleanup_git() {
        local description="Git Repos GC"
        info "Running aggressive git gc in all repos..."
        find "$HOME/Personal" -name ".git" -type d -prune -print0 | while IFS= read -r -d '' gitdir; do
            local size
            size=$(du -sb -- "$gitdir" 2>/dev/null | awk '{print $1}') || size=0
            if [[ "$DRY_RUN" == true ]]; then
                warn "[DRY RUN] Would run git gc in $gitdir ($(numfmt --to=iec-i --suffix=B $size))"
            else
                git --git-dir="$gitdir" --work-tree="$(dirname "$gitdir")" gc --prune=now --aggressive || warn "Git gc failed in $gitdir"
                freed_space["$description"]=$(( ${freed_space["$description"]:-0} + size ))
            fi
        done
    }

    # --- ADVANCED CLEANUP ---
    cleanup_advanced() {
        info "--- Starting Advanced Cleanup ---"
        cleanup_basic

        _cleanup_item "$HOME/.m2/repository/*" "Maven Repository"
        _cleanup_item "$HOME/.gradle/caches/*" "Gradle Caches"
        _cleanup_item "$HOME/.cargo/registry/cache/*" "Cargo Registry Cache"
        _cleanup_item "$HOME/Personal/**/target" "Rust Target Folders"

        _cleanup_python_venvs

        if [[ "$DRY_RUN" == false ]]; then
            read -q "REPLY?Proceed with Docker & Git cleanup? (y/n) "; echo
            if [[ "$REPLY" =~ ^[Yy]$ ]]; then
                _cleanup_docker
                _cleanup_git
            fi
        else
            warn "[DRY RUN] Skipping Docker & Git prompt, would run both"
            _cleanup_docker
            _cleanup_git
        fi

        ok "--- Advanced Cleanup Complete ---"
    }

    # --- REPORT ---
    show_report() {
        info "--- Cleanup Report ---"
        local total_freed=0
        for k in "${(@k)freed_space}"; do
            total_freed=$((total_freed + freed_space[$k]))
        done
        echo -e "${GREEN}Total freed:${NC} $(numfmt --to=iec-i --suffix=B $total_freed)"

        info "--- Top 5 Hogs ---"
        for line in $(for k in "${(@k)freed_space}"; do echo "${freed_space[$k]}|$k"; done | sort -rn | head -n5); do
            local size="${line%%|*}"
            local desc="${line##*|}"
            echo "  - $desc ($(numfmt --to=iec-i --suffix=B $size))"
        done
    }

    # --- MENU ---
    show_menu() {
        echo -e "
${BLUE}===== Ultimate Developer Cleanup Utility =====${NC}
 ${GREEN}1. Basic Cleanup${NC} (Safe)
 ${GREEN}2. Advanced Cleanup${NC} (Aggressive)
 ${GREEN}q. Quit${NC}"
        echo -n -e "${YELLOW}Enter choice: ${NC}"
    }

    [[ "${1-}" == "--dry-run" ]] && DRY_RUN=true && shift

    while true; do
        show_menu
        read -r choice
        case "$choice" in
            1) cleanup_basic ;;
            2) cleanup_advanced ;;
            [qQ]) break ;;
            *) error "Invalid option" ;;
        esac
    done

    show_report

    # Cleanup local functions
    unfunction info ok warn error _cleanup_item _cleanup_cmd _cleanup_python_venvs _cleanup_docker _cleanup_git cleanup_basic cleanup_advanced show_report show_menu 2>/dev/null || true
}
