#autoload
# Refactored Ultimate Cleanup Utility

cleanup() {
    emulate -L zsh
    set -u
    local DRY_RUN=false
    local AUTO_MODE="none"  # "none", "basic", "advanced"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) DRY_RUN=true; shift ;;
            --auto) AUTO_MODE="advanced"; shift ;;
            --auto=*)
                local val="${1#*=}"
                if [[ "$val" == "basic" || "$val" == "advanced" ]]; then
                    AUTO_MODE="$val"
                else
                    error "Invalid value for --auto: $val"
                    return 1
                fi
                shift ;;
            *) break ;;
        esac
    done

    local GREEN='\033[0;32m'
    local YELLOW='\033[0;33m'
    local BLUE='\033[0;34m'
    local RED='\033[0;31m'
    local NC='\033[0m'
    typeset -A freed_space
    local -a BASIC_PATHS
    local -a ADVANCED_PATHS

    # Log cleanup activity
    _log_cleanup() {
        local log_file="$HOME/.cache/cleanup.log"
        local timestamp=$(/bin/date '+%Y-%m-%d %H:%M:%S')
        /bin/mkdir -p "$(/usr/bin/dirname "$log_file")"
        /usr/bin/echo "[$timestamp] $*" >> "$log_file"
    }

    # --- Logging helpers ---
    log() {
        /usr/bin/echo -e "$1$2$NC"
        _log_cleanup "$2"
    }
    info()  { log "$BLUE" "ℹ️  $*"; }
    ok()    { log "$GREEN" "✅ $*"; }
    warn()  { log "$YELLOW" "⚠️  $*"; }
    error() { log "$RED" "❌ $*"; }

    # --- Safe delete ---
    _safe_delete() {
        local path="$1" desc="$2" sudo_flag="${3:-false}"
        
        # Enhanced safety check: resolve path and compare against home
        local resolved_path
        if command -v realpath &>/dev/null; then
            resolved_path=$(realpath -m -- "$path" 2>/dev/null)
        elif command -v readlink &>/dev/null; then
            resolved_path=$(readlink -f -- "$path" 2>/dev/null)
        else
            resolved_path="$path"
        fi

        if [[ "$resolved_path" == "$HOME" ]]; then
            error "Unsafe path: $path resolves to home directory"
            return
        fi
        [[ -z "$path" || "$path" == "/" ]] && error "Unsafe path: $path" && return

        local -a files=()
        if [[ "$path" == *"*"* ]]; then
            setopt localoptions nullglob globdots extendedglob
            files=($~path)
        elif [[ -e "$path" ]]; then
            files=("$path")
        fi
        local total=0

        for f in "${files[@]}"; do
            [[ ! -e "$f" ]] && continue
            local size=$(/usr/bin/du -sb -- "$f" 2>/dev/null | /usr/bin/awk '{print $1}')
            total=$((total + size))

            if $DRY_RUN; then
                warn "[DRY RUN] Would delete $desc: $f ($(/usr/bin/numfmt --to=iec-i --suffix=B $size))"
            else
                if $sudo_flag; then
                    if ! command -v sudo &>/dev/null; then
                        warn "sudo command not found, cannot delete: $f"
                        continue
                    fi
                    /usr/bin/sudo /bin/rm -rf -- "$f" 2>/dev/null || warn "Failed: $f"
                else
                    /bin/rm -rf -- "$f" 2>/dev/null || warn "Failed: $f"
                fi
            fi
        done

        [[ $total -gt 0 ]] && freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + total ))
    }

    # --- Run and track space by monitoring path ---
    _run_and_track_space() {
        if ! command -v du &>/dev/null || ! command -v awk &>/dev/null; then
            warn "Skipping '$1': missing 'du' or 'awk'."
            return
        fi
        local desc="$1" monitor="$2"; shift 2
        local before=0 after=0

        if [[ -d "$monitor" ]]; then
            if [[ "$monitor" == "/var/"* ]]; then
                before=$(/usr/bin/sudo /usr/bin/du -sb -- "$monitor" 2>/dev/null | /usr/bin/awk '{print $1}')
            else
                before=$(/usr/bin/du -sb -- "$monitor" 2>/dev/null | /usr/bin/awk '{print $1}')
            fi
        fi

        if $DRY_RUN; then
            warn "[DRY RUN] Would run: $desc"
        else
            info "Running: $desc"
            "$@" || warn "$desc failed"
        fi

        if [[ -d "$monitor" ]]; then
            if [[ "$monitor" == "/var/"* ]]; then
                after=$(/usr/bin/sudo /usr/bin/du -sb -- "$monitor" 2>/dev/null | /usr/bin/awk '{print $1}')
            else
                after=$(/usr/bin/du -sb -- "$monitor" 2>/dev/null | /usr/bin/awk '{print $1}')
            fi
        fi
        local freed=$((before - after))
        [[ $freed -gt 0 ]] && freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + freed ))
    }

    # --- Run and parse space from command output ---
    _run_and_parse_space() {
        if ! command -v numfmt &>/dev/null || ! command -v grep &>/dev/null; then
            warn "Skipping '$1': missing 'numfmt' or 'grep'."
            return
        fi
        local desc="$1" regex="$2"; shift 2

        if $DRY_RUN; then
            warn "[DRY RUN] Would run: $desc"
            return
        fi

        info "Running: $desc"
        local output=$("$@" 2>&1)
        local total=0

        while read -r freed_h; do
            [[ -z "$freed_h" ]] && continue
            local b=$(echo "$freed_h" | /usr/bin/numfmt --from=iec --suffix=B 2>/dev/null)
            (( $? == 0 )) && total=$((total + b))
        done <<< "$(/usr/bin/echo "$output" | /usr/bin/grep -oP "$regex")"

        [[ $total -gt 0 ]] && freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + total ))
    }

    # --- Load paths from config ---
    _load_cleanup_paths() {
        local basic_config="$HOME/.config/cleanup/basic.conf"
        local advance_config="$HOME/.config/cleanup/advance.conf"
        BASIC_PATHS=()
        ADVANCED_PATHS=()

        if [[ -f "$basic_config" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                [[ -z "$line" ]] && continue
                local expanded_line=${line//\$HOME/$HOME}
                BASIC_PATHS+=("$expanded_line")
            done < "$basic_config"
        else
            warn "Basic config file not found: $basic_config"
        fi

        if [[ -f "$advance_config" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                [[ -z "$line" ]] && continue
                local expanded_line=${line//\$HOME/$HOME}
                ADVANCED_PATHS+=("$expanded_line")
            done < "$advance_config"
        else
            warn "Advance config file not found: $advance_config"
        fi

        return 0
    }

    # --- Cleanup broken symlinks ---
    _cleanup_broken_symlinks() {
        local desc="Broken Symlinks"
        local search_path="$HOME"
        info "Searching for and removing broken symlinks in $search_path..."

        local -a broken_links=()
        # Use a loop to handle potential errors with find and large numbers of files
        while IFS= read -r -d '' link; do
            broken_links+=("$link")
        done < <(/usr/bin/find "$search_path" -xtype l -print0 2>/dev/null)
        
        local count=${#broken_links[@]}

        if (( count == 0 )); then
            ok "No broken symlinks found."
            return
        fi

        if $DRY_RUN; then
            warn "[DRY RUN] Would delete $count broken symlinks from $search_path"
            for link in "${broken_links[@]}"; do
                warn "[DRY RUN] Would delete $desc: $link"
            done
            # Just add a placeholder for the report, space is negligible
            freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + count ))
            return
        fi

        info "Removing $count broken symlinks..."
        for link in "${broken_links[@]}"; do
            /bin/rm -- "$link" 2>/dev/null
        done
        ok "Removed $count broken symlinks."
        freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + count ))
    }

    # --- Cleanup old kernels ---
    _cleanup_old_kernels() {
        local desc="Old Kernels"
        info "Searching for old kernels to remove..."

        if ! command -v dpkg-query &> /dev/null; then
            warn "Skipping old kernel cleanup: not a Debian-based system."
            return
        fi

        local current_kernel_image="linux-image-$(/usr/bin/uname -r)"
        local current_kernel_headers="linux-headers-$(/usr/bin/uname -r)"

        local all_images=()
    mapfile -t all_images < <(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 2>/dev/null | sort -V)
        
        local all_headers=()
    mapfile -t all_headers < <(dpkg-query -W -f='${Package}\n' 'linux-headers-[0-9]*' 2>/dev/null | sort -V)

        if (( ${#all_images[@]} < 2 && ${#all_headers[@]} < 2 )); then
            ok "No old kernels to remove (less than 2 installed)."
            return
        fi

        local latest_image="${all_images[-1]}"
        local latest_headers="${all_headers[-1]}"

        local kernels_to_keep=("$current_kernel_image" "$current_kernel_headers" "$latest_image" "$latest_headers")
        local unique_kernels_to_keep
        unique_kernels_to_keep=(${(u)kernels_to_keep})

        local all_kernels=("${all_images[@]}" "${all_headers[@]}")
        
        local kernels_to_remove=()
        for kernel in "${all_kernels[@]}"; do
            if ! [[ " ${unique_kernels_to_keep[*]} " =~ " ${kernel} " ]]; then
                kernels_to_remove+=("$kernel")
            fi
        done
        
        local unique_kernels_to_remove
        unique_kernels_to_remove=(${(u)kernels_to_remove})

        if (( ${#unique_kernels_to_remove[@]} == 0 )); then
            ok "No old kernels to remove."
            return
        fi

    _run_and_parse_space "$desc" 'After this operation, (?:an additional )?\\K[0-9,.]+ [a-zA-Z]+' sudo apt-get autoremove --purge -y "${unique_kernels_to_remove[@]}"
    }

    cleanup_basic() {
        info "--- Starting Basic Cleanup ---"
        for entry in "${BASIC_PATHS[@]}"; do
            local path desc sudo_flag
            IFS=':' read -r path desc sudo_flag <<< "$entry"
            sudo_flag="${sudo_flag:-false}"
            _safe_delete "$path" "$desc" "$sudo_flag"
        done

    _safe_delete "/var/cache/apt/archives/*" "APT Cache Clean" true
    _run_and_parse_space "APT Autoclean" 'cleared \K[0-9,.]+[ a-zA-Z]+' sudo apt-get autoclean -y
    _run_and_parse_space "APT Autoremove" 'After this operation, (?:an additional )?\\K[0-9,.]+ [a-zA-Z]+' sudo apt-get autoremove --purge -y

        _cleanup_broken_symlinks

        ok "--- Basic Cleanup Complete ---"
    }

    cleanup_advanced() {
        info "--- Starting Advanced Cleanup ---"
        cleanup_basic

        for entry in "${ADVANCED_PATHS[@]}"; do
            local path desc sudo_flag
            IFS=':' read -r path desc sudo_flag <<< "$entry"
            sudo_flag="${sudo_flag:-false}"
            _safe_delete "$path" "$desc" "$sudo_flag"
        done

        if command -v flatpak &>/dev/null; then
            _run_and_track_space "Flatpak Unused" "/var/lib/flatpak" flatpak uninstall --unused -y
        else
            warn "Flatpak not found; skipping Flatpak cleanup"
        fi

        if command -v docker &>/dev/null; then
            _run_and_parse_space "Docker Prune" 'Total reclaimed space:\\s*\\K[0-9.]+[A-Za-z]+' sudo docker system prune -af --volumes
        else
            warn "Docker not found; skipping Docker prune"
        fi

        _cleanup_old_kernels

        ok "--- Advanced Cleanup Complete ---"
    }

    show_report() {
        info "--- Cleanup Report ---"
        local total=0
        for k in "${(@k)freed_space}"; do total=$((total + freed_space[$k])); done
    /usr/bin/echo -e "${GREEN}Total freed:${NC} $([[ $total -gt 0 ]] && /usr/bin/numfmt --to=iec-i --suffix=B $total || echo '0B')"

        (( total == 0 )) && warn "Nothing left to clean!" && return

        info "--- Top Freed ---"
        for line in "${(@f)$(for k in "${(@k)freed_space}"; do /usr/bin/echo "${freed_space[$k]}|$k"; done | /usr/bin/sort -rn | /usr/bin/head -n5)}"; do
            local size="${line%%|*}" desc="${line##*|}"
            /usr/bin/echo "  - $desc ($(/usr/bin/numfmt --to=iec-i --suffix=B $size))"
        done
    }

    # --- Menu ---
    _load_cleanup_paths || return 1

    if [[ "$AUTO_MODE" == "advanced" ]]; then
        cleanup_advanced
    elif [[ "$AUTO_MODE" == "basic" ]]; then
        cleanup_basic
    else
        while true; do
            echo -e "\n${BLUE}===== Ultimate Cleanup Utility =====${NC}"
            echo -e " ${GREEN}1.${NC} Basic Cleanup (safe)"
            echo -e " ${GREEN}2.${NC} Advanced Cleanup (aggressive)"
            echo -e " ${GREEN}q.${NC} Quit"
            echo -n -e "${YELLOW}Enter choice: ${NC}"

            read -r choice
            case "$choice" in
                1) cleanup_basic ;;
                2) cleanup_advanced ;;
                [qQ]) break ;;
                *) error "Invalid option" ;;
            esac
        done
    fi

    show_report
}

cleanup "$@"
