#autoload

extract() {
	local dest_dir=""
	if [[ "$1" == "-d" || "$1" == "--dir" ]]; then
		dest_dir="${2%.*}"
		mkdir -p "$dest_dir"
		shift 2
	fi

	for f in "$@"; do
		if [ -f "$f" ]; then
			local target_dir="$dest_dir"
			if [[ -n "$target_dir" ]]; then
				# If a destination directory is specified, extract into it
				case "$f" in
				*.tar.bz2) tar xjf "$f" -C "$target_dir" || echo "Extraction failed" ;;
				*.tar.gz) tar xzf "$f" -C "$target_dir" || echo "Extraction failed" ;;
				*.tar.xz) tar xf "$f" -C "$target_dir" || echo "Extraction failed" ;;
				*.zip) unzip "$f" -d "$target_dir" || echo "Extraction failed" ;;
				*.rar) unrar x "$f" "$target_dir/" || echo "Extraction failed" ;;
				*)
					# For other formats, we need to move the extracted files
					local temp_dir=$(mktemp -d)
					(cd "$temp_dir" && "$0" "$f")
					mv "$temp_dir"/* "$target_dir/"
					rmdir "$temp_dir"
					;;
				esac
			else
				# Original behavior
				case "$f" in
				*.tar.bz2) tar xjf "$f" || echo "Extraction failed" ;;
				*.tar.gz) tar xzf "$f" || echo "Extraction failed" ;;
				*.tar.xz) tar xf "$f" || echo "Extraction failed" ;;
				*.bz2) bunzip2 "$f" || echo "Extraction failed" ;;
				*.rar) unrar x "$f" || echo "Extraction failed" ;;
				*.gz) gunzip "$f" || echo "Extraction failed" ;;
				*.tar) tar xf "$f" || echo "Extraction failed" ;;
				*.tbz2) tar xjf "$f" || echo "Extraction failed" ;;
				*.tgz) tar xzf "$f" || echo "Extraction failed" ;;
				*.zip) unzip "$f" || echo "Extraction failed" ;;
				*.Z) uncompress "$f" || echo "Extraction failed" ;;
				*.7z) 7z x "$f" || echo "Extraction failed" ;;
				*.xz) unxz "$f" || echo "Extraction failed" ;;
				*) echo "Don't know how to extract '$f'..." ;;
				esac
			fi
		else
			echo "'$f' is not a valid file!"
		fi
	done
}
