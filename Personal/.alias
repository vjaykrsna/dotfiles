# ==================================================================
# PERSONAL ALIASES
# ==================================================================

# Basic navigation and utilities
alias ls='eza'
alias ll='eza -alh --icons'
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias -- -='cd -'
alias bat='batcat'

# Zsh editing
alias editzsh="micro $HOME/.zshrc"
alias reloadzsh="source $HOME/.zshrc"

# Git aliases
commit() { git commit -m "$*"; }
alias lgit='lazygit'
gitlog() { git log --oneline --graph --decorate --all -n "${1:-5}"; }

# System & Monitoring
alias mem='free -h'
alias cpu='btop'
alias temp='sensors'
alias usage='du -sh .[!.]* * 2>/dev/null | awk '\''$1 ~ /K$/ && $1+0 >= 50 || $1 ~ /M|G$/'\'' | sort -hr'
alias update='sudo apt update && sudo apt upgrade -y'
alias netcheck='ping -c 4 google.com'
alias ports='sudo lsof -i -P -n | grep LISTEN'

# Custom Apps
myzram() {
    local C_TITLE='\033[1;36m' # Bold Cyan
    local C_HEADER='\033[1;33m' # Bold Yellow
    local C_VALUE='\033[0;32m'  # Green
    local C_RESET='\033[0m'     # Reset Color

    printf "${C_TITLE}===== ZRAM Status Report =====${C_RESET}\n\n"
    printf "${C_HEADER}📊 Memory Usage:${C_RESET}\n"
    free -h | sed 's/^/  /'
    echo

    printf "${C_HEADER}📦 ZRAM Device Status:${C_RESET}\n"
    zramctl | column -t | sed 's/^/  /'
    echo

    printf "${C_HEADER}📈 Compression Ratio:${C_RESET}\n"
    local ratio_info=$(zramctl --bytes --output=NAME,DATA,COMPR)
    local ratio=$(echo "$ratio_info" | awk 'NR==2 && $3>0 {printf "%.2f : 1", $2/$3}')
    printf "  Compression Ratio: ${C_VALUE}%s${C_RESET}\n" "$ratio"
    printf "\n${C_TITLE}============================${C_RESET}\n"
}
alias hackerui='$HOME/Applications/xDEX-UI-Linux-x86_64.AppImage --no-sandbox'
alias dockerui='lazydocker'
alias yadmcode='GIT_DIR=~/.local/share/yadm/repo.git code ~'

# ==================================================================
# RUNTIME MANAGERS (shared)
# ==================================================================
# Note: NVM_DIR is exported from ~/.profile. Use fallback if unset.
nvm() {
    local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
    if [ -s "$nvm_dir/nvm.sh" ]; then
        unset -f nvm 2>/dev/null || true
        . "$nvm_dir/nvm.sh"
        nvm "$@"
    else
        echo "nvm: nvm.sh not found in $nvm_dir" >&2
        return 127
    fi
}
