#!/usr/bin/env bash
set -euo pipefail

DRY_RUN=false
AUTO_MODE="none"  # "none", "basic", "advanced"

# --- Parse args ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --auto) AUTO_MODE="advanced"; shift ;;
        --auto=*)
            val="${1#*=}"
            if [[ "$val" == "basic" || "$val" == "advanced" ]]; then
                AUTO_MODE="$val"
            else
                echo -e "\033[0;31m❌ Invalid value for --auto: $val\033[0m"
                exit 1
            fi
            shift ;;
        *) break ;;
    esac
done

# --- Colors ---
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

# --- Freed space tracking ---
declare -A freed_space
BASIC_PATHS=()
ADVANCED_PATHS=()

# --- Logging helpers ---
info()  { echo -e "${BLUE}ℹ️  $*${NC}"; }
ok()    { echo -e "${GREEN}✅ $*${NC}"; }
warn()  { echo -e "${YELLOW}⚠️  $*${NC}"; }
error() { echo -e "${RED}❌ $*${NC}"; }

# --- Safe delete ---
_safe_delete() {
    local path="$1" desc="$2" sudo_flag="${3:-false}"
    local resolved_path
    resolved_path=$(realpath -m -- "$path" 2>/dev/null || echo "")
    [[ -z "$resolved_path" || "$resolved_path" == "$HOME" || "$resolved_path" == "/" ]] && { error "Unsafe path: $path"; return; }

    local files=()
    if [[ "$path" == *"*"* ]]; then
        shopt -s nullglob dotglob
        files=($path)
        shopt -u nullglob dotglob
    elif [[ -e "$path" ]]; then
        files=("$path")
    fi

    local total=0
    for f in "${files[@]}"; do
        [[ ! -e "$f" ]] && continue
        local size
        size=$(du -sb -- "$f" 2>/dev/null | awk '{print $1}')
        total=$((total + size))

        if $DRY_RUN; then
            warn "[DRY RUN] Would delete $desc: $f ($(numfmt --to=iec-i --suffix=B $size))"
        else
            if [[ "$sudo_flag" == true ]]; then
                sudo rm -rf -- "$f" 2>/dev/null || warn "Failed: $f"
            else
                rm -rf -- "$f" 2>/dev/null || warn "Failed: $f"
            fi
        fi
    done
    [[ $total -gt 0 ]] && freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + total ))
}

# --- Load cleanup paths ---
_load_cleanup_paths() {
    local basic_config="$HOME/.config/cleanup/basic.conf"
    local advance_config="$HOME/.config/cleanup/advance.conf"

    if [[ -f "$basic_config" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" ]] && continue
            BASIC_PATHS+=("${line//\$HOME/$HOME}")
        done < "$basic_config"
    else
        warn "Basic config file not found: $basic_config"
    fi

    if [[ -f "$advance_config" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ -z "$line" ]] && continue
            ADVANCED_PATHS+=("${line//\$HOME/$HOME}")
        done < "$advance_config"
    else
        warn "Advance config file not found: $advance_config"
    fi
}

# --- Cleanup broken symlinks ---
_cleanup_broken_symlinks() {
    local desc="Broken Symlinks"
    info "Searching for and removing broken symlinks in $HOME..."
    local broken_links=()
    while IFS= read -r -d '' link; do
        broken_links+=("$link")
    done < <(find "$HOME" -xtype l -print0 2>/dev/null)

    local count=${#broken_links[@]}
    if (( count == 0 )); then
        ok "No broken symlinks found."
        return
    fi

    if $DRY_RUN; then
        warn "[DRY RUN] Would delete $count broken symlinks"
        freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + count ))
        return
    fi

    info "Removing $count broken symlinks..."
    for link in "${broken_links[@]}"; do
        rm -- "$link" 2>/dev/null
    done
    ok "Removed $count broken symlinks."
    freed_space["$desc"]=$(( ${freed_space["$desc"]:-0} + count ))
}

# --- Cleanup old kernels ---
_cleanup_old_kernels() {
    local desc="Old Kernels"
    info "Searching for old kernels..."
    # Bash-compatible lists
    mapfile -t all_images < <(dpkg-query -W -f='${Package}\n' 'linux-image-[0-9]*' 2>/dev/null | sort -V)
    mapfile -t all_headers < <(dpkg-query -W -f='${Package}\n' 'linux-headers-[0-9]*' 2>/dev/null | sort -V)

    if (( ${#all_images[@]} < 2 && ${#all_headers[@]} < 2 )); then
        ok "No old kernels to remove."
        return
    fi

    local current_image="linux-image-$(uname -r)"
    local current_headers="linux-headers-$(uname -r)"
    local latest_image="${all_images[-1]}"
    local latest_headers="${all_headers[-1]}"

    local keep=("$current_image" "$current_headers" "$latest_image" "$latest_headers")
    local remove=()
    for k in "${all_images[@]}" "${all_headers[@]}"; do
        [[ ! " ${keep[*]} " =~ " $k " ]] && remove+=("$k")
    done

    if (( ${#remove[@]} == 0 )); then
        ok "No old kernels to remove."
        return
    fi

    if $DRY_RUN; then
        warn "[DRY RUN] Would autoremove old kernels: ${remove[*]}"
    else
        sudo apt-get autoremove --purge -y "${remove[@]}" >/dev/null 2>&1
        info "Old kernels removed."
    fi
}

# --- Basic cleanup ---
cleanup_basic() {
    info "--- Starting Basic Cleanup ---"
    for entry in "${BASIC_PATHS[@]}"; do
        IFS=':' read -r path desc sudo_flag <<< "$entry"
        sudo_flag="${sudo_flag:-false}"
        _safe_delete "$path" "$desc" "$sudo_flag"
    done

    _safe_delete "/var/cache/apt/archives/*" "APT Cache Clean" true
    sudo apt-get autoclean -y >/dev/null 2>&1
    sudo apt-get autoremove --purge -y >/dev/null 2>&1

    _cleanup_broken_symlinks
    ok "--- Basic Cleanup Complete ---"
}

# --- Advanced cleanup ---
cleanup_advanced() {
    info "--- Starting Advanced Cleanup ---"
    cleanup_basic

    for entry in "${ADVANCED_PATHS[@]}"; do
        IFS=':' read -r path desc sudo_flag <<< "$entry"
        sudo_flag="${sudo_flag:-false}"
        _safe_delete "$path" "$desc" "$sudo_flag"
    done

    if command -v flatpak &>/dev/null; then
        flatpak uninstall --unused -y >/dev/null 2>&1
    fi

    if command -v docker &>/dev/null; then
        sudo docker system prune -af --volumes >/dev/null 2>&1
    fi

    _cleanup_old_kernels
    ok "--- Advanced Cleanup Complete ---"
}

# --- Show report ---
show_report() {
    info "--- Cleanup Report ---"
    local total=0
    for v in "${freed_space[@]}"; do
        total=$((total + v))
    done
    echo -e "${GREEN}Total freed:${NC} $([[ $total -gt 0 ]] && numfmt --to=iec-i --suffix=B $total || echo '0B')"
}

# --- Main ---
_load_cleanup_paths

if [[ "$AUTO_MODE" == "advanced" ]]; then
    cleanup_advanced
elif [[ "$AUTO_MODE" == "basic" ]]; then
    cleanup_basic
else
    while true; do
        echo -e "\n${BLUE}===== Ultimate Cleanup Utility =====${NC}"
        echo -e " ${GREEN}1.${NC} Basic Cleanup (safe)"
        echo -e " ${GREEN}2.${NC} Advanced Cleanup (aggressive)"
        echo -e " ${GREEN}q.${NC} Quit"
        echo -n -e "${YELLOW}Enter choice: ${NC}"

        read -r choice
        case "$choice" in
            1) cleanup_basic ;;
            2) cleanup_advanced ;;
            [qQ]) break ;;
            *) error "Invalid option" ;;
        esac
    done
fi

show_report
