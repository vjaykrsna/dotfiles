#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: dockerctl {start|stop|restart|status|logs|clean|update} {service1|all} ..."
    exit 1
fi

action="$1"
shift

case "$action" in
    start|stop|restart|status|logs|clean|update) ;;
    *)
        echo "❌ Invalid action '$action'. Use: start, stop, restart, status, logs, clean, update"
        exit 1
        ;;
esac

# Load config
CONFIG_FILE="$HOME/.config/dockerctl/config"
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
DOCKERCTL_PROJECTS_DIR="${DOCKERCTL_PROJECTS_DIR:-$HOME/Personal/myDocker}"

# Determine services
services=()
if [[ "${1:-}" == "all" ]]; then
    for d in "$DOCKERCTL_PROJECTS_DIR/"*/; do
        [[ -d "$d" ]] && services+=("$(basename "$d")")
    done
else
    services=("$@")
fi

# Add dependencies if starting
if [[ "$action" == "start" && ${#DOCKERCTL_DEPS[@]} -gt 0 ]]; then
    resolved_services=()
    for service in "${services[@]}"; do
        if [[ -n "${DOCKERCTL_DEPS[$service]-}" ]]; then
            for dep in ${DOCKERCTL_DEPS[$service]}; do
                [[ ! " ${resolved_services[*]} " =~ " $dep " ]] && resolved_services+=("$dep")
            done
        fi
        [[ ! " ${resolved_services[*]} " =~ " $service " ]] && resolved_services+=("$service")
    done
    services=("${resolved_services[@]}")
fi

# Process each service
for service in "${services[@]}"; do
    dir="$DOCKERCTL_PROJECTS_DIR/$service"
    if [[ ! -d "$dir" ]]; then
        echo "❌ Service '$service' not found at $dir"
        continue
    fi

    echo "🔧 $action $service..."
    (
        cd "$dir" || { echo "❌ Failed to cd $dir"; exit 1; }
        case "$action" in
            start) docker compose up -d ;;
            stop) docker compose down ;;
            restart) docker compose down && sleep 2 && docker compose up -d ;;
            status) docker compose ps ;;
            logs) docker compose logs -f ;;
            clean)
                docker compose down
                docker system prune -a --volumes -f
                ;;
            update)
                docker compose pull
                docker compose down
                docker compose up -d
                docker image prune -f
                ;;
        esac
    )
    echo "✅ $action $service done!"
done
