#!/usr/bin/env bash
set -euo pipefail

# --- 1️⃣ Ask for AppImage path ---
read -rp "Enter full path to the AppImage: " APPIMAGE_PATH
if [ ! -f "$APPIMAGE_PATH" ]; then
    echo "❌ File not found!"
    exit 1
fi

# --- 2️⃣ Ensure ~/Applications exists ---
CONFIG_FILE="$HOME/.config/appimage_installer/config"
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi
APPDIR="${APPIMAGE_INSTALL_DIR:-$HOME/Applications}"
mkdir -p "$APPDIR"

# --- 3️⃣ Prepare destination ---
APPIMAGE_NAME=$(basename "$APPIMAGE_PATH")
DEST_PATH="$APPDIR/$APPIMAGE_NAME"

# Handle duplicates automatically
if [ -f "$DEST_PATH" ]; then
    i=1
    base="${APPIMAGE_NAME%.*}"
    ext="${APPIMAGE_NAME##*.}"
    while [ -f "$APPDIR/$base-$i.$ext" ]; do
        ((i++))
    done
    DEST_PATH="$APPDIR/$base-$i.$ext"
    echo "⚠️ Duplicate detected. Saving as $(basename "$DEST_PATH")"
fi

mv "$APPIMAGE_PATH" "$DEST_PATH"
chmod +x "$DEST_PATH"

# --- 4️⃣ Ask for app name and category ---
DEFAULT_NAME="${APPIMAGE_NAME%.*}"
read -rp "Enter application name [${DEFAULT_NAME}]: " APP_NAME
APP_NAME="${APP_NAME:-$DEFAULT_NAME}"

read -rp "Enter category (e.g., Utility, Development, Game) [Utility]: " CATEGORY
CATEGORY="${CATEGORY:-Utility}"

# --- 5️⃣ Extract icon from AppImage (if available) ---
ICON_PATH="$HOME/.local/share/icons/${APP_NAME// /_}.png"
if command -v bsdtar >/dev/null 2>&1; then
    bsdtar -tf "$DEST_PATH" 2>/dev/null | grep -Ei '\.(png|svg)$' | head -n1 | while read -r iconfile; do
        mkdir -p "$(dirname "$ICON_PATH")"
        bsdtar -xf "$DEST_PATH" "$iconfile" --to-stdout >"$ICON_PATH"
        break
    done
fi

if [ ! -f "$ICON_PATH" ]; then
    ICON_PATH="$DEST_PATH" # fallback: use AppImage itself
fi

# --- 6️⃣ Create .desktop file ---
DESKTOP_FILE="$HOME/.local/share/applications/${APP_NAME// /_}.desktop"
mkdir -p "$(dirname "$DESKTOP_FILE")"

cat >"$DESKTOP_FILE" <<EOL
[Desktop Entry]
Name=$APP_NAME
Exec=$DEST_PATH
Icon=$ICON_PATH
Type=Application
Terminal=false
Categories=${CATEGORY};
EOL

# --- 7️⃣ Update desktop database ---
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$HOME/.local/share/applications"
fi
if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$DESKTOP_FILE"
fi

echo "✅ $APP_NAME added to Applications menu!"
echo "You can now search it in your launcher."
