#!/bin/zsh
# Ram Status Script - Shows RAM, Zram compressed swap, and Disk swap usage
# Usage: myzram [--detailed|-d] (default: compact, detailed: multi-line format)

local C_TITLE='\033[1;36m'    # Bold Cyan - Titles
local C_HEADER='\033[1;35m'   # Bold Magenta - Section headers
local C_LABEL='\033[1;34m'    # Bold Blue - Labels
local C_VALUE='\033[0;32m'    # Green - Values
local C_WARN='\033[0;31m'     # Red - Warnings/Alerts
local C_PERCENT='\033[0;33m'  # Yellow - Percentages
local C_RESET='\033[0m'       # Reset Color

# Check for detailed mode flag (default is now compact)
local detailed_mode=false
[[ "$1" == "--detailed" || "$1" == "-d" ]] && detailed_mode=true

# Calculate maximum label width for alignment
local max_label_width=10

# Check for ZRAM compression ratio early
local zram_ratio=""
local zram_swap_info=$(swapon -s 2>/dev/null | grep zram)
if [[ -n "$zram_swap_info" ]]; then
    local ratio_info=$(zramctl --bytes --output=DATA,COMPR | tail -n +2)
    zram_ratio=$(echo "$ratio_info" | awk '$2>0 {printf "%.1f", $1/$2}')
fi

if $detailed_mode; then
    printf "${C_TITLE}Memory Status${C_RESET}\n\n"
else
    if [[ -n "$zram_ratio" ]]; then
        printf "${C_TITLE}Memory Status ${C_VALUE}(${zram_ratio}:1)${C_RESET}\n"
    else
        printf "${C_TITLE}Memory Status${C_RESET}\n"
    fi
fi

# RAM Section
local mem_info=$(free -h | awk 'NR==2 {print $2, $3, $4, $7}')
local mem_total=$(echo $mem_info | awk '{print $1}')
local mem_used=$(echo $mem_info | awk '{print $2}')
local mem_free=$(echo $mem_info | awk '{print $3}')
local mem_avail=$(echo $mem_info | awk '{print $4}')
local mem_usage_pct=$(free | awk 'NR==2 {printf "%.1f", $3/$2*100}')

if $detailed_mode; then
    printf "${C_HEADER}RAM Memory${C_RESET}\n"
    printf "${C_TITLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
    printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Total:" "$mem_total"
    printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET} ${C_PERCENT}(%5.1f%%)${C_RESET}\n" "Used:" "$mem_used" "$mem_usage_pct"
    printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Free:" "$mem_free"
    printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Available:" "$mem_avail"
    echo
    else
        local mem_usage_pct_int=$(printf "%.0f" "$mem_usage_pct")
        printf "${C_HEADER}%-5s${C_RESET}${C_VALUE}%7s${C_RESET} used ${C_PERCENT}(%s%%)${C_RESET} | ${C_VALUE}%7s${C_RESET} avail\n" "RAM:" "$mem_used" "$mem_usage_pct_int" "$mem_avail"
    fi

# Compressed Swap (Zram) Section
if [[ -n "$zram_swap_info" ]]; then
    local zram_device=$(echo $zram_swap_info | awk '{print $1}')
    local zram_swap_size_kb=$(echo $zram_swap_info | awk '{print $3}')
    local zram_swap_used_kb=$(echo $zram_swap_info | awk '{print $4}')
    local zram_swap_size=$(echo $zram_swap_size_kb | awk '{print $1*1024}' | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${zram_swap_size_kb}K")
    local zram_swap_used=$(echo $zram_swap_used_kb | awk '{print $1*1024}' | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${zram_swap_used_kb}K")
    local zram_swap_avail_kb=$((zram_swap_size_kb - zram_swap_used_kb))
    local zram_swap_avail=$(echo $zram_swap_avail_kb | awk '{print $1*1024}' | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${zram_swap_avail_kb}K")
    local zram_swap_pct=$(echo "$zram_swap_size_kb $zram_swap_used_kb" | awk '{printf "%.1f", $2/$1*100}')

    # Use the ratio calculated at the top level
    local ratio=$(echo "$zram_ratio" | awk '{printf "%.2f", $1}')

    if $detailed_mode; then
        printf "${C_HEADER}Compressed Swap (ZRAM)${C_RESET}\n"
        printf "${C_TITLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
        printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Device:" "$zram_device"
        printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Size:" "$zram_swap_size"
        printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET} ${C_PERCENT}(%5.1f%%)${C_RESET}\n" "Used:" "$zram_swap_used" "$zram_swap_pct"
        printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Available:" "$zram_swap_avail"
        [[ -n "$ratio" ]] && printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Ratio:" "$ratio:1"
        echo
    else
        local zram_swap_pct_int=$(printf "%.0f" "$zram_swap_pct")
        printf "${C_HEADER}%-5s${C_RESET}${C_VALUE}%7s${C_RESET} used ${C_PERCENT}(%s%%)${C_RESET} | ${C_VALUE}%7s${C_RESET} avail\n" "ZRAM:" "$zram_swap_used" "$zram_swap_pct_int" "$zram_swap_avail"
    fi
else
    if $detailed_mode; then
        printf "${C_HEADER}Compressed Swap (ZRAM)${C_RESET}\n"
        printf "${C_TITLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
        printf "${C_LABEL}Status:${C_RESET}    ${C_WARN}Not configured${C_RESET}\n"
        echo
    else
        printf "${C_HEADER}ZRAM:${C_RESET} ${C_WARN}not configured${C_RESET}\n"
    fi
fi

# Disk Swap Section
local disk_swap_info=$(swapon -s 2>/dev/null | grep -v zram | tail -n +2)
if [[ -n "$disk_swap_info" ]]; then
    local disk_swap_stats=$(echo "$disk_swap_info" | awk '
        BEGIN { total_kb = 0; used_kb = 0; devices = 0 }
        { total_kb += $3; used_kb += $4; devices++ }
        END { print total_kb, used_kb, devices }
    ')

    local disk_swap_total_kb=$(echo $disk_swap_stats | awk '{print $1}')
    local disk_swap_used_kb=$(echo $disk_swap_stats | awk '{print $2}')
    local disk_swap_devices=$(echo $disk_swap_stats | awk '{print $3}')

    if [[ $disk_swap_total_kb -gt 0 ]]; then
        local disk_swap_total=$(echo $disk_swap_total_kb | awk '{print $1*1024}' | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${disk_swap_total_kb}K")
        local disk_swap_used=$(echo $disk_swap_used_kb | awk '{print $1*1024}' | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${disk_swap_used_kb}K")
        local disk_swap_free_kb=$((disk_swap_total_kb - disk_swap_used_kb))
        local disk_swap_free=$(echo $disk_swap_free_kb | awk '{print $1*1024}' | numfmt --to=iec-i --suffix=B 2>/dev/null || echo "${disk_swap_free_kb}K")
        local disk_swap_pct=$(echo "$disk_swap_total_kb $disk_swap_used_kb" | awk '{printf "%.1f", $2/$1*100}')

        if $detailed_mode; then
            printf "${C_HEADER}Disk Swap${C_RESET}\n"
            printf "${C_TITLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
            printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Total:" "$disk_swap_total"
            printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET} ${C_PERCENT}(%5.1f%%)${C_RESET}\n" "Used:" "$disk_swap_used" "$disk_swap_pct"
            printf "${C_LABEL}%-10s${C_RESET} ${C_VALUE}%8s${C_RESET}\n" "Free:" "$disk_swap_free"
            echo
        else
            local disk_swap_pct_int=$(printf "%.0f" "$disk_swap_pct")
            printf "${C_HEADER}%-5s${C_RESET}${C_VALUE}%7s${C_RESET} used ${C_PERCENT}(%s%%)${C_RESET} | ${C_VALUE}%7s${C_RESET} free\n" "Disk:" "$disk_swap_used" "$disk_swap_pct_int" "$disk_swap_free"
        fi
    else
        if $detailed_mode; then
            printf "${C_HEADER}Disk Swap${C_RESET}\n"
            printf "${C_TITLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
            printf "${C_LABEL}Status:${C_RESET}    ${C_WARN}No active swap${C_RESET}\n"
            echo
        else
            printf "${C_HEADER}Disk:${C_RESET} ${C_WARN}no active swap${C_RESET}\n"
        fi
    fi
else
    if $detailed_mode; then
        printf "${C_HEADER}Disk Swap${C_RESET}\n"
        printf "${C_TITLE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}\n"
        printf "${C_LABEL}Status:${C_RESET}    ${C_WARN}Not configured${C_RESET}\n"
        echo
    else
        printf "${C_HEADER}Disk:${C_RESET} ${C_WARN}not configured${C_RESET}\n"
    fi
fi
