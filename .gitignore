# ==============================================================================
# yadm Dotfiles .gitignore
#
# This file uses a whitelist-based strategy:
# 1. Ignore everything by default (`*`).
# 2. Explicitly un-ignore (`!`) the files and directories to be tracked.
# 3. Explicitly re-ignore specific sub-folders, caches, and secrets.
# ==============================================================================

# 1. IGNORE EVERYTHING BY DEFAULT
# ==============================================================================
*

# 2. WHITELIST - Files and Directories to Track
# ==============================================================================

# Core Shell & Git Configuration
!/.bashrc
!/.bash_profile
!/.zshrc
!/.zprofile
!/.bash_logout
!/.zlogout
!/.profile
!/.gitconfig
!/.gitmodules
!/.gitignore
!/.gitattributes

# Personal Scripts, Projects, and Applications
!/Personal/
!/Personal/**
/Personal/myGithub/
!/Applications/
!/Applications/**

# Desktop Environment: Themes, Icons, Fonts
!/.themes/
!/.themes/**
!/.icons/
!/.icons/**
!/.local/
!/.local/share/
!/.local/bin/

# Application Configurations (~/.config/)
!/.config/
!/.config/autostart/
!/.config/autostart/**
!/.config/background
!/.config/dconf/
!/.config/dconf/gnome_settings.ini
!/.config/gnome-shell/
!/.config/gnome-shell/**
!/.config/input-remapper-2/
!/.config/input-remapper-2/**
!/.config/micro/
!/.config/micro/*.json
!/.config/Rygel/
!/.config/Rygel/**
!/.config/starship.toml
!/.config/systemd/
!/.config/systemd/user/
!/.config/systemd/user/**
!/.config/user-dirs.dirs
!/.config/user-dirs.locale
!/.config/yadm/
!/.config/yadm/encrypt
!/.config/cleanup/
!/.config/cleanup/**
!/.config/dockerctl/
!/.config/dockerctl/**
!/.qwen/
!/.qwen/settings.json
!/.gemini/
!/.gemini/settings.json

# yadm Archive
!/.local/share/yadm/
!/.local/share/yadm/archive

# 3. BLACKLIST - Caches, Runtime Files, and Secrets
# ==============================================================================

# General Caches & Temporary Directories
/.cache/
.npm/
.nvm/
.vscode/
.bun/
.android/
.dotnet/
.mozilla/
.pki/
.roo/

# Common Junk Files
.DS_Store
Thumbs.db
AGENTS.md
*.pyc

# Shell History & Runtime Files
.bash_history
.zsh_history
.node_repl_history
.zcompdump
.sudo_as_admin_successful
.wget-hsts

# Noisy Application Configs & Caches
/.config/**/[cC]ache/
/.config/**/*.tmp
/.config/**/*.temp
/.config/**/{history,log,logs}
/.config/BraveSoftware/
/.config/Code/
/.config/Code/User/workspaceStorage/
/.config/chromium/
/.config/configstore/update-notifier-*
/.config/enchant/en_US.*
/.config/evolution/sources/system-proxy.source
/.config/gnome-initial-setup-done
/.config/google-chrome/
/.config/google-chrome-for-testing/
/.config/ibus/bus/*
/.config/input-remapper-2/runtime/
/.config/microsoft-edge-beta/
/.config/microsoft-edge-dev/
/.config/pulse/*-runtime
/.config/pulse/cookie
/.config/vscode-sqltools/runningInfo.json

# ---
# Final Override for Encrypted Files
# ---
# NOTE: The patterns in this section should mirror those in the
# ~/.config/yadm/encrypt file. This ensures the unencrypted source
# files are ignored by Git, while the encrypted archive is tracked.
/.ssh/
/.gnupg/
/.git-credentials
/.config/gsconnect/*.pem
**/.env
# Zen Browser sensitive files ignored in
# .var/app/app.zen_browser.zen/.gitignore itself

# ------------------------------------------------------------------------------
# Explicit VS Code override: un-ignore parent directories and the single
# `mcp_settings.json` file. This must appear after the `.config/Code/` blacklist
# above so the re-include takes effect.
# ------------------------------------------------------------------------------
!/.config/
!/.config/Code/
!/.config/Code/User/
!/.config/Code/User/globalStorage/
!/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/
!/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/
!/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json

*.cache