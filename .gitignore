# ========================================================
# IGNORE EVERYTHING BY DEFAULT
# ========================================================
*

# ========================================================
# WHITELIST SAFE DOTFILES
# ========================================================
!.bashrc
!.zshrc
!.profile
!.gitconfig
!.gitmodules
!.gitignore
!.gitattributes
!.env                # tracked but encrypted (see .gitattributes)
!.config/
!.config/**

# Personal List
!Personal/
!Personal/**

# ========================================================
# WHITELISTED CONFIGS (portable / reproducible)
# ========================================================
# Input Remapper (keyboard/gamepad)
!.config/input-remapper-2/config.json
!.config/input-remapper-2/presets/
!.config/input-remapper-2/xmodmap.json

# Micro editor (bindings only)
!.config/micro/bindings.json

# GSConnect (optional reproducible setup)
!.config/gsconnect/certificate.pem
!.config/gsconnect/private.pem

# Rygel / Media server
!.config/Rygel/MediaExport*.xml
!.config/rygel.conf

# User directories / environment
!.config/user-dirs.dirs
!.config/user-dirs.locale

# Autostart scripts & personal setups
!.config/autostart/guake.desktop
!.config/background

# ========================================================
# IGNORE COMMON CACHE, TEMP, AND LOG FILES
# ========================================================
.config/**/[cC]ache/
.config/**/*.tmp
.config/**/*.temp
.config/**/{history,log,logs}

# Exclude noisy application configs
.config/BraveSoftware/
.config/Code/
.config/google-chrome/
.config/chromium/
.config/microsoft-edge-beta/
.config/microsoft-edge-dev/
.config/Code/User/workspaceStorage/

# Runtime / session files (local-only)
.config/input-remapper-2/runtime/
.config/pulse/*-runtime
.config/pulse/cookie
.config/ibus/bus/*
.config/micro/buffers/history

# ========================================================
# SENSITIVE FILES (tracked only via yadm-crypt)
# ========================================================
!.ssh/
!.gnupg/
!/.local/
!/.local/share/
!/.local/share/yadm/
!/.local/share/yadm/archive
.config/dconf/user
.config/gsconnect/private.pem
.config/gsconnect/certificate.pem

# ========================================================
# EXPLICITLY IGNORED (junk, caches, local)
# ========================================================
# Shell history
.bash_history
.zsh_history

# GnuPG runtime sockets
.gnupg/S.*
.gnupg/*.lock

# SSH pubkeys (public, no need to track)
.ssh/*.pub
.ssh/authorized_keys

# Package caches & tmp
.cache/
.npm/
.nvm/
.var/
.vscode/
.bun/
.android/
.dotnet/
.mozilla/
.pki/
.qwen/
.node_repl_history
.zcompdump

# Misc local-only junk
.sudo_as_admin_successful
.wget-hsts
.DS_Store
Thumbs.db
.roo/
AGENTS.md

# Noisy files identified by user feedback
.config/configstore/update-notifier-*
.config/enchant/en_US.*
.config/evolution/sources/system-proxy.source
.config/gnome-initial-setup-done
.config/vscode-sqltools/runningInfo.json

# Python bytecode
*.pyc

# ========================================================
# WHITELISTED FROM .LOCAL (portable / reproducible)
# ========================================================
# Un-ignore the parent directories first
!.local/
!.local/share/
!.local/share/gnome-shell/
!.local/share/gnome-shell/extensions/
!.local/share/gnome-shell/extensions/*/

# Track essential extension files
!.local/share/gnome-shell/extensions/*/metadata.json
!.local/share/gnome-shell/extensions/*/schemas/
!.local/share/gnome-shell/extensions/*/schemas/**
!.local/share/gnome-shell/extensions/*/extension.js
!.local/share/gnome-shell/extensions/*/prefs.js
!.local/share/gnome-shell/extensions/*/config.js
!.local/share/gnome-shell/extensions/*/settings.js
!.local/share/gnome-shell/extensions/*/*.py
!.local/share/gnome-shell/extensions/*/preferences/
!.local/share/gnome-shell/extensions/*/preferences/**
!.local/share/gnome-shell/extensions/*/service/
!.local/share/gnome-shell/extensions/*/service/**
!.local/share/gnome-shell/extensions/*/shell/
!.local/share/gnome-shell/extensions/*/shell/**
!.local/share/gnome-shell/extensions/*/utils/
!.local/share/gnome-shell/extensions/*/utils/**
!.local/share/gnome-shell/extensions/*/PrefsLib/
!.local/share/gnome-shell/extensions/*/PrefsLib/**

# Ignore heavy resource / media directories
.local/share/gnome-shell/extensions/*/Resources/
.local/share/gnome-shell/extensions/*/Resources/**
# Font files are managed by LFS (see .gitattributes)
!.local/share/fonts/
!.local/share/fonts/**
.local/share/gnome-shell/extensions/*/locale/
.local/share/gnome-shell/extensions/*/locale/**
.local/share/gnome-shell/extensions/*/icons/
.local/share/gnome-shell/extensions/*/icons/**
.local/share/gnome-shell/extensions/*/images/
.local/share/gnome-shell/extensions/*/images/**
.local/share/gnome-shell/extensions/*/sounds/
.local/share/gnome-shell/extensions/*/sounds/**
.local/share/gnome-shell/extensions/*/data/
.local/share/gnome-shell/extensions/*/data/**
.local/share/gnome-shell/extensions/*/docs/
.local/share/gnome-shell/extensions/*/docs/**
.local/share/gnome-shell/extensions/*/cache/
.local/share/gnome-shell/extensions/*/cache/**
.local/share/gnome-shell/extensions/*/README*
.local/share/gnome-shell/extensions/*/CHANGELOG*
.local/share/gnome-shell/extensions/*/LICENSE*
.local/share/gnome-shell/extensions/*/COPYING*
.local/share/gnome-shell/extensions/*/*.md
.local/share/gnome-shell/extensions/*/*.txt
