# ========================================================
# IGNORE EVERYTHING BY DEFAULT
# ========================================================
*

# ========================================================
# WHITELIST SAFE DOTFILES
# ========================================================
!.bashrc
!.zshrc
!.profile
!.gitconfig
!.gitmodules
!.gitignore
!.env                # tracked but encrypted (see .gitattributes)
!.config/
!.config/starship.toml

# Personal scripts & projects
!Personal/
!Personal/**

# ========================================================
# SENSITIVE FILES (tracked only via yadm-crypt)
# ========================================================
!.ssh/
!.gnupg/

# ========================================================
# EXPLICITLY IGNORED (junk, cache, or unsafe)
# ========================================================
# Shell history
.bash_history
.zsh_history

# GnuPG runtime sockets
.gnupg/S.*
.gnupg/*.lock

# SSH pubkeys (public, no need to track)
.ssh/*.pub
.ssh/authorized_keys

# Package caches & tmp
.cache/
.npm/
.nvm/
.var/
.vscode/
.bun/
.android/
.dotnet/
.mozilla/
.pki/
.qwen/
.node_repl_history
.zcompdump

# Misc local-only junk
.sudo_as_admin_successful
.wget-hsts
.DS_Store
Thumbs.db
.roo/
AGENTS.md
