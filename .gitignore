# ========================================================
# IGNORE EVERYTHING BY DEFAULT
# ========================================================
*

# ========================================================
# SAFE DOTFILES TO TRACK
# ========================================================
!.bashrc
!.zshrc
!.profile
!.gitconfig
!.gitmodules
!.gitignore
!.gitattributes

# ========================================================
# PERSONAL FILES
# ========================================================
!Personal/
!Personal/**
!Applications/
!Applications/**

# ========================================================
# CONFIGS TO TRACK (portable / reproducible)
# ========================================================
!.config/
!.config/dconf/
!.config/dconf/gnome_settings.ini

# Input Remapper
!.config/input-remapper-2/
!.config/input-remapper-2/config.json
!.config/input-remapper-2/presets/
!.config/input-remapper-2/xmodmap.json

# Micro editor
!.config/micro/
!.config/micro/bindings.json

# GSConnect (only certs if reproducible setup)

# Rygel / Media server
!.config/Rygel/
!.config/Rygel/MediaExport*.xml
!.config/rygel.conf

# User directories / environment
!.config/user-dirs.dirs
!.config/user-dirs.locale

# Autostart & background
!.config/autostart/
!.config/autostart/guake.desktop
!.config/background

# Systemd services
!.config/systemd/
!.config/systemd/user/
!.config/systemd/user/**

# Starship prompt
!.config/starship.toml

# Yadm config
!.config/yadm/
!.config/yadm/encrypt
!.local/share/yadm/
!.local/share/yadm/archive

# ========================================================
# LOCAL SHARE FILES
# ========================================================
# Un-ignore the parent directories first
!.local/
!.local/share/
# Fonts (managed by Git LFS)
!.local/share/fonts/
!.local/share/fonts/**
# GNOME Shell extensions (track only list)
!.config/gnome-shell/
!.config/gnome-shell/extensions.txt
!.local/share/gnome-shell/

# ========================================================
# THEMES & ICONS
# ========================================================
!.themes/
!.themes/**
!.icons/
!.icons/**

# ========================================================
# CRYPTED / SENSITIVE
# ========================================================
!.ssh/
!.ssh/config
!.ssh/authorized_keys

# ========================================================
# IGNORE CACHES, TEMP, NOISY LOCAL FILES
# ========================================================
.cache/
.npm/
.nvm/
.var/
.vscode/
.bun/
.android/
.dotnet/
.mozilla/
.pki/
.qwen/
.gemini/
.node_repl_history
.zcompdump
.sudo_as_admin_successful
.wget-hsts
.DS_Store
Thumbs.db
.roo/
AGENTS.md

# Python bytecode
*.pyc

# Shell history
.bash_history
.zsh_history

# GnuPG runtime
.gnupg/S.*
.gnupg/*.lock

# SSH pubkeys (not needed)
.ssh/*.pub

# Input Remapper runtime
.config/input-remapper-2/runtime/

# Pulse & IBus runtime
.config/pulse/*-runtime
.config/pulse/cookie
.config/ibus/bus/*

# Micro runtime buffers
.config/micro/buffers/history

# App caches (noisy configs)
.config/**/[cC]ache/
.config/**/*.tmp
.config/**/*.temp
.config/**/{history,log,logs}
.config/BraveSoftware/
.config/Code/
.config/Code/User/workspaceStorage/
.config/google-chrome/
.config/google-chrome-for-testing/
.config/chromium/
.config/microsoft-edge-beta/
.config/microsoft-edge-dev/

# Other noisy files
.config/configstore/update-notifier-*
.config/enchant/en_US.*
.config/evolution/sources/system-proxy.source
.config/gnome-initial-setup-done
.config/vscode-sqltools/runningInfo.json
