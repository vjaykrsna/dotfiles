{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "android",
    "position": "top",
    "padding": { "left": 17, "bottom": 1 }
  },
  "display": {
    "size": { "maxPrefix": "GB", "ndigits": 1 },
    "key": { "type": "both" }
  },
  "modules": [
    { "type": "title", "format": "termux @ vivo I2219" },
    "separator",
    "os",
    { "type": "command", "key": "Kernel", "text": "uname -r | cut -d- -f1" },
    "uptime",
    "shell",
    "terminal",
    { "type": "cpu", "format": "{name} ({cores-physical}) @ {freq-max}" },
    "gpu",
    "memory",
    "swap",
    { "type": "command", "key": "Disk", "text": "df -h /storage/emulated | tail -1 | awk '{print $3\" / \"$2\" (\"$5\")\"}'" },
    "localip",
    "battery",
    "colors"
  ]
}
